{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test:*)",
      "Bash(./gradlew :*:test:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew :*:build:*)",
      "Bash(./gradlew :*:compileJava:*)",
      "Bash(./gradlew :*:compileTestJava:*)",
      "Bash(./gradlew projects:*)",
      "Bash(./gradlew :*:dependencies:*)",
      "Bash(./gradlew tasks:*)",
      "Bash(npm run build:*)",
      "Bash(npm --prefix visual-lab-app run build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./visual-lab-app/node_modules/**)",
      "Read(./visual-lab-app/dist/**)",
      "Read(./**/build/**)",
      "Read(./.gradle/**)"
    ]
  }
}
