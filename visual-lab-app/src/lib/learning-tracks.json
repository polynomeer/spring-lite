{
  "stages": [
    { "id": "concept", "label": "개념", "summary": "왜 필요한가. 짧은 글과 핵심 질문 하나로 시작한다." },
    { "id": "build", "label": "구현", "summary": "실패하는 테스트를 통과시키며 직접 만든다." },
    { "id": "experiment", "label": "실험", "summary": "결과를 먼저 예측하고 실행한 뒤, 틀리면 리플레이로 원인을 찾는다." },
    { "id": "compare", "label": "비교", "summary": "같은 시나리오를 실제 Spring Boot와 나란히 놓고 차이를 짚는다." }
  ],
